# Copy to .env and fill in the values for your machine.
# The backend reads these through ./run-backend.sh.

# ---- Spring Boot ----
SPRING_APPLICATION_NAME=cloud-care

# Supabase PostgreSQL.
# Direct connection (works for most local/dev machines):
#   jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# If your network blocks port 5432, use the Supabase pooler instead:
#   jdbc:postgresql://aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
#   and set SPRING_DATASOURCE_USERNAME=postgres.<project-ref>
# Keep the local example below while developing offline, then switch to the
# Supabase values from Project Settings → Database.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cloudcare
SPRING_DATASOURCE_USERNAME=cloudcare
SPRING_DATASOURCE_PASSWORD=cloudcare
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect
SPRING_THYMELEAF_CACHE=false
SPRING_MVC_STATIC_PATH_PATTERN=/**
SPRING_WEB_RESOURCES_STATIC_LOCATIONS=classpath:/static/

# ---- Supabase Storage ----
# Project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=
# Service-role key (Project Settings → API). Server-side only — never expose
# this in the frontend. The bucket must exist and be PUBLIC so the returned
# object URLs render without a signed-url round trip.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=cloudcare

# ---- Admin bootstrap account ----
# Created on first startup if no admin exists. CHANGE THIS before deploying
# anywhere real — the value below is a throwaway for local demo use only.
ADMIN_EMAIL=demo.admin@cloudcare.test
ADMIN_PASSWORD=change-me-before-deploying

# ---- Optional third-party services ----
# Email is only used for real notification mail. The demo flows work without it.
BREVO_API_KEY=replace-me
BREVO_SENDER_EMAIL=demo@cloudcare.test
BREVO_SENDER_NAME="CloudCare Demo"

# NOTE: there is deliberately no AI/LLM key here. The application has no model
# integration — don't add one expecting it to be wired up.

# Prescription follow-up reminders. Defaults to hourly; the job also runs once
# at startup and is idempotent, so no additional configuration is needed.
# PRESCRIPTION_REMINDER_CRON=0 0 * * * *
