# CloudCare backend environment.
#   cp .env.example .env
# ./run-backend.sh loads it. Everything below is active and boots the app
# locally as-is. A full Render/production reference is at the bottom —
# for a real deploy, copy that block into Render's dashboard instead.

# ---- Database (required) ---------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.enynwlpimyfitbiskxnl
SPRING_DATASOURCE_PASSWORD=


# ---- Bootstrap admin account (required) ------------------------------------
# Created on first start if no admin with this email exists yet.
ADMIN_EMAIL=demo.admin@cloudcare.test
ADMIN_PASSWORD=admin123

# ---- File uploads via Supabase Storage (optional) ---------------------------
# Only needed for photo/certificate/report uploads; everything else works
# without it. SUPABASE_SERVICE_ROLE_KEY is a server-side secret — never put
# it in frontend code.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=cloudcare

# ---- Email via Brevo (optional) ---------------------------------------------
# Without a key, emails are skipped and logged instead — password-reset
# links print to the console, so the flow still works without this.
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=no-reply@your-domain.com
# BREVO_SENDER_NAME="CloudCare"

# ---- CORS / frontend URL (optional, defaults shown) -------------------------
# CLOUDCARE_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
# CLOUDCARE_FRONTEND_URL=http://localhost:3000
# SESSION_COOKIE_SECURE=false   # true behind HTTPS

# ---- Tuning (optional, defaults shown) ---------------------------------------
# SPRING_JPA_HIBERNATE_DDL_AUTO=update
# SPRING_JPA_SHOW_SQL=false
# SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10
# PRESCRIPTION_REMINDER_CRON=0 0 * * * *


# =============================================================================
# RENDER DEPLOY REFERENCE — this project's actual production values.
# Not read locally; copy whichever lines you need into Render's dashboard
# under Environment, as plain KEY=VALUE pairs (no leading #).
# PORT needs no entry — application.properties already binds to it.
# =============================================================================

# Database — Supabase Postgres via the session pooler (works from Render's
# IPs; the direct :5432 host often doesn't). Exact host is per-region: get it
# from Supabase -> Project Settings -> Database -> Connection string ->
# "Transaction pooler".
# SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres.enynwlpimyfitbiskxnl
# SPRING_DATASOURCE_PASSWORD=<the Supabase project's database password, not an API key>

# Bootstrap admin — a real email and a strong, unique password; this account
# approves doctors and reads donor/feedback data in production.
# ADMIN_EMAIL=<your real admin email>
# ADMIN_PASSWORD=<a strong password>

# Supabase Storage — same project as the database above.
# SUPABASE_URL=https://enynwlpimyfitbiskxnl.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<Supabase -> Settings -> API -> service_role key>
# SUPABASE_STORAGE_BUCKET=cloudcare

# CORS / frontend — the live Vercel deployment.
# CLOUDCARE_ALLOWED_ORIGINS=https://cloudcare-nu.vercel.app
# CLOUDCARE_FRONTEND_URL=https://cloudcare-nu.vercel.app
# SESSION_COOKIE_SECURE=true
