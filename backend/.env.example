# CloudCare backend environment. Copy to `.env` and fill in:
#   cp .env.example .env
# ./run-backend.sh loads it. Only the REQUIRED block is needed to boot;
# every other setting has a default in src/main/resources/application.properties.

# ---- REQUIRED: database --------------------------------------------------
# Local Postgres:
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cloudcare
SPRING_DATASOURCE_USERNAME=cloudcare
SPRING_DATASOURCE_PASSWORD=cloudcare
# Supabase Postgres instead (Project Settings -> Database):
#   jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# If port 5432 is blocked, use the pooler and username postgres.<project-ref>:
#   jdbc:postgresql://aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# ---- REQUIRED: bootstrap admin account ----------------------------------
# Created on first start if missing. Change the password before deploying.
ADMIN_EMAIL=demo.admin@cloudcare.test
ADMIN_PASSWORD=change-me-before-deploying

# ---- Optional: file uploads (Supabase Storage) --------------------------
# Needed only for photo/certificate/report uploads. Server-side key; never
# expose it to the frontend. The bucket must exist and be public.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=cloudcare

# ---- Optional: email (Brevo) ---------------------------------------------
# Without a key, emails are skipped and logged. Password-reset links are then
# printed to the backend console so the flow still works locally.
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=no-reply@your-domain.com
# BREVO_SENDER_NAME="CloudCare"

# ---- Optional: deployment (defaults shown) -------------------------------
# CLOUDCARE_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
# CLOUDCARE_FRONTEND_URL=http://localhost:3000
# SESSION_COOKIE_SECURE=false   # true behind HTTPS

# ---- Optional: tuning (defaults shown) -----------------------------------
# SPRING_JPA_HIBERNATE_DDL_AUTO=update
# SPRING_JPA_SHOW_SQL=false
# SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10
# PRESCRIPTION_REMINDER_CRON=0 0 * * * *
