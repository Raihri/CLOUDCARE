# CloudCare backend environment. Copy to `.env` and fill in:
#   cp .env.example .env
# ./run-backend.sh loads it. Only the REQUIRED block is needed to boot;
# every other setting has a default in src/main/resources/application.properties.
#
# Two worked examples are given everywhere it matters: LOCAL (what's active
# below, for running on your own machine) and RENDER (commented out, the
# real values for this project's production deploy on Render + Supabase +
# Vercel) so copying one deploy's settings to another is just uncommenting.

# ---- REQUIRED: database ---------------------------------------------------
# LOCAL — Postgres running on your machine:
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cloudcare
SPRING_DATASOURCE_USERNAME=cloudcare
SPRING_DATASOURCE_PASSWORD=cloudcare

# RENDER — Supabase Postgres via the session pooler (works from Render's
# IPs without extra config; the direct :5432 host often doesn't).
# Get the exact pooler host for your region from Supabase ->
# Project Settings -> Database -> Connection string -> "Transaction pooler".
#   SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
#   SPRING_DATASOURCE_USERNAME=postgres.enynwlpimyfitbiskxnl
#   SPRING_DATASOURCE_PASSWORD=<the Supabase project's database password, not an API key>

# ---- REQUIRED: bootstrap admin account ------------------------------------
# Created on first start if no admin with this email exists yet.
# LOCAL default — fine to keep as-is for your own dev box:
ADMIN_EMAIL=demo.admin@cloudcare.test
ADMIN_PASSWORD=admin123

# RENDER — use a real email and a strong, unique password; this account can
# approve doctors and read donor/feedback data in production.
#   ADMIN_EMAIL=<your real admin email>
#   ADMIN_PASSWORD=<a strong password, not admin123>

# ---- Optional: file uploads (Supabase Storage) ----------------------------
# Needed only for photo/certificate/report uploads. SUPABASE_SERVICE_ROLE_KEY
# is a server-side secret — never put it in frontend code or commit it here.
# The bucket must exist (Supabase -> Storage -> New bucket, mark it public).
#
# RENDER — this project's Supabase project:
#   SUPABASE_URL=https://enynwlpimyfitbiskxnl.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY=<Supabase -> Settings -> API -> service_role key>
#   SUPABASE_STORAGE_BUCKET=cloudcare

# ---- Optional: email (Brevo) -----------------------------------------------
# Without a key, emails are skipped and logged instead — password-reset
# links print to the console/log, so the flow still works without this.
# Leave unset (as below) if you don't want email sending at all.
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=no-reply@your-domain.com
# BREVO_SENDER_NAME="CloudCare"

# ---- Optional: deployment (defaults shown) ---------------------------------
# Who's allowed to call the API / open the WebSocket, and where password-reset
# links point. LOCAL default (commented, matches application.properties):
# CLOUDCARE_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
# CLOUDCARE_FRONTEND_URL=http://localhost:3000
# SESSION_COOKIE_SECURE=false   # true behind HTTPS

# RENDER — this project's live frontend on Vercel:
#   CLOUDCARE_ALLOWED_ORIGINS=https://cloudcare-nu.vercel.app
#   CLOUDCARE_FRONTEND_URL=https://cloudcare-nu.vercel.app
#   SESSION_COOKIE_SECURE=true

# Render also assigns its own port via PORT; the app already binds to it
# automatically (server.port=${PORT:8080} in application.properties) —
# nothing to set here.

# ---- Optional: tuning (defaults shown) -------------------------------------
# SPRING_JPA_HIBERNATE_DDL_AUTO=update
# SPRING_JPA_SHOW_SQL=false
# SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10
# PRESCRIPTION_REMINDER_CRON=0 0 * * * *
